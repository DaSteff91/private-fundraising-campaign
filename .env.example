# Copy to .env on your laptop. Never commit .env.
# Production `npm run build` fails if required values are empty.

PORT=7890
LIVE_DIR=./live
SITE_URL=http://127.0.0.1:7890

# Shown in the UI and thank-you page title.
CAMPAIGN_NAME=Sam's Workshop
# SEPA / GiroCode payment reference (ASCII preferred). Keep stable for the campaign.
CAMPAIGN_REMITTANCE=Sams Workshop

# ISO 4217 donation currency (UI, presets, PayPal.Me). GiroCode / SEPA QR only when EUR.
DONATION_CURRENCY=EUR
# Optional ISO 4217 for thank-you “forwarded” total (settings.amountLocal). Empty = hide.
LOCAL_CURRENCY=

# PocketBase URL baked into the browser bundle:
# - Local direct: http://127.0.0.1:5789
# - Production (same-origin): leave empty → browser calls /api on SITE_URL;
#   server.mjs (or Vite dev proxy) forwards to POCKETBASE_UPSTREAM.
POCKETBASE_URL=http://127.0.0.1:5789

# Must match the bank account-holder name exactly (SEPA Verification of Payee).
PAYEE_NAME=Max Mustermann
# Official IBAN example — replace with your IBAN (no spaces).
PAYEE_IBAN=DE89370400440532013000
PAYEE_BIC=BYLADEM1001

# Reusable Wise "from anyone" / Wisetag URL, no fixed amount.
WISE_REQUEST_URL=https://wise.com/pay/me/example

# PayPal.Me handle (personal account, not business). Handle only, or a pasted paypal.me URL.
# Amount is appended at runtime: https://www.paypal.com/paypalme/{handle}/25.00EUR
PAYPAL_ME_HANDLE=example

OPERATOR_NAME=Max Mustermann
OPERATOR_STREET=Musterstrasse 1
OPERATOR_ZIP=80331
OPERATOR_CITY=Muenchen
OPERATOR_EMAIL=demo@example.test
